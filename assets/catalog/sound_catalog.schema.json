{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sleep Heaven Sound Catalog",
  "type": "object",
  "required": ["version", "sounds"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "categoryId", "assetPath", "imagePath", "isPremium"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "categoryId": {"type": "string", "minLength": 1},
          "assetPath": {"type": "string", "pattern": "^assets/sounds/.+\\.mp3$"},
          "imagePath": {"type": "string", "pattern": "^assets/images/.+\\.(png|jpg|jpeg|webp)$"},
          "isPremium": {"type": "boolean"},
          "icon": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
